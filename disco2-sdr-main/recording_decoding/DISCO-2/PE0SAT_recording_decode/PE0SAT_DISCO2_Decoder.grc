- name: satellites_fsk_demodulator_1
  id: satellites_fsk_demodulator
  parameters:
    affinity: ''
    alias: ''
    baudrate: '4800'
    comment: "DISCO2 transmits at 4800 baud.\nFollowing Nyquist-Shannon sampling theorem.\
      \ \na minimum of 9600Hz after decimation is good\nto avoid data loss. Any value\
      \ of decimation that puts \nthe sample rate below 9600 will result in warnings\
      \ and\nin the case of weak signals data loss/undecodability.\n\nbtw this block\
      \ also performs clock recovery"
    iq: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    options: '""'
    samp_rate: samp_rate/decimation
    subaudio: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 496.0]
    rotation: 0
    state: enabled
- name: satellites_sync_to_pdu_0
  id: satellites_sync_to_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: "Finds DISCO-2 sync word and create PDU\n\nNL signal is very good, so\
      \ can run at treshold 0\nDK needs a treshold of 2 to find and succesfully\n\
      deconde packets\n\nPack length for succesful terrestiral ping decoding was 689,\n\
      but that is too low for the data sent from space,\nat 1200 we get packets and\
      \ are able to decode them,\ncould be lower though 1200 seems to be ok\nnumber\
      \ was arrived at by random choice, \nwould be nice to know how this impacts\
      \ the overall\npipline. Tested with 900 and also works"
    maxoutbuf: '0'
    minoutbuf: '0'
    packlen: '1200'
    sync: '"0101010101010101010101010111111010101010"'
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 392.0]
    rotation: 0
    state: enabled
